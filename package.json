{
  "name": "codex-wordpress-builder",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts/build.mjs scripts/lab.mjs scripts/lab-wp.mjs scripts/lab-bind.mjs scripts/deploy-lab.mjs scripts/migrate-demo.mjs scripts/test-theme.mjs scripts/audit-lab.mjs scripts/test-new-site.mjs scripts/reference-site.mjs scripts/test-reference-site.mjs scripts/hongda-site.mjs scripts/test-hongda-site.mjs scripts/hongda-snapshot.mjs scripts/hongda-restore.mjs scripts/test-hongda-recovery.mjs scripts/test-hongda-enquiry.mjs scripts/wordpress-ready.mjs scripts/hongda-package.mjs scripts/hongda-clean-site.mjs scripts/hongda-e2e.mjs scripts/hongda-native.mjs scripts/build-block-starter.mjs examples/b2b-block-starter/scripts/*.mjs examples/b2b-block-starter/scripts/release/*.mjs scripts/hostinger/*.mjs scripts/harness-doctor.mjs",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:theme": "node scripts/test-theme.mjs",
    "build": "node scripts/build.mjs",
    "wp": "tsx src/cli.ts",
    "lab": "node scripts/lab.mjs",
    "lab:wp": "node scripts/lab-wp.mjs",
    "verify:snapshot": "node scripts/verify-snapshot.mjs",
    "test:new-site": "node scripts/test-new-site.mjs",
    "reference:serve": "node scripts/reference-site.mjs",
    "test:reference": "node scripts/test-reference-site.mjs",
    "hongda:serve": "node scripts/hongda-site.mjs",
    "test:hongda": "node scripts/test-hongda-site.mjs",
    "hongda:snapshot": "node scripts/hongda-snapshot.mjs",
    "hongda:restore": "node scripts/hongda-restore.mjs",
    "test:hongda:recovery": "node scripts/test-hongda-recovery.mjs",
    "test:hongda:enquiry": "node scripts/test-hongda-enquiry.mjs",
    "hongda:package": "node scripts/hongda-package.mjs",
    "hongda:clean": "node scripts/hongda-clean-site.mjs",
    "hongda:e2e": "node scripts/hongda-e2e.mjs",
    "hongda:native": "node scripts/hongda-native.mjs",
    "starter:start": "node examples/b2b-block-starter/scripts/start.mjs",
    "starter:design": "node examples/b2b-block-starter/scripts/design.mjs && node scripts/build-block-starter.mjs && node examples/b2b-block-starter/scripts/sync.mjs && node examples/b2b-block-starter/scripts/apply-design.mjs",
    "test:starter:plugins": "node examples/b2b-block-starter/scripts/plugins-check.mjs",
    "test:starter:seo": "node examples/b2b-block-starter/scripts/rankmath-check.mjs && node examples/b2b-block-starter/scripts/seo.mjs",
    "test:starter:design": "node examples/b2b-block-starter/scripts/design-check.mjs && node examples/b2b-block-starter/scripts/conversion.mjs",
    "starter:sync": "node examples/b2b-block-starter/scripts/sync.mjs",
    "test:starter": "node examples/b2b-block-starter/scripts/check.mjs && node examples/b2b-block-starter/scripts/browser.mjs && node examples/b2b-block-starter/scripts/screens.mjs && node examples/b2b-block-starter/scripts/seo.mjs && node examples/b2b-block-starter/scripts/inquiry.mjs",
    "test:starter:release": "node examples/b2b-block-starter/scripts/release.mjs",
    "hostinger:preflight": "node scripts/hostinger/preflight.mjs",
    "test:starter:template-update": "node examples/b2b-block-starter/scripts/template-update-check.mjs",
    "starter:update-preflight": "node examples/b2b-block-starter/scripts/update-preflight.mjs",
    "hostinger:setup": "node .agents/skills/wordpress-builder/scripts/hostinger-setup.mjs",
    "harness:doctor": "node scripts/harness-doctor.mjs",
    "harness:setup": "node scripts/harness-doctor.mjs --setup"
  },
  "dependencies": {
    "csv-parse": "7.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@wp-playground/blueprints": "3.1.52",
    "@wp-playground/cli": "3.1.52",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
