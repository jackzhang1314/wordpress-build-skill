{
  "name": "codex-wordpress-builder",
  "version": "2.10.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests harness/cli.mjs harness/init.mjs harness/lib tests/harness scripts/build.mjs scripts/lab.mjs scripts/lab-wp.mjs scripts/lab-bind.mjs scripts/package-starter.mjs",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs tests/harness/*.test.mjs",
    "build": "node scripts/build.mjs",
    "wp": "tsx src/cli.ts",
    "lab": "node scripts/lab.mjs",
    "lab:wp": "node scripts/lab-wp.mjs",
    "verify:snapshot": "node scripts/verify-snapshot.mjs",
    "harness": "node harness/cli.mjs",
    "package:starter": "node scripts/package-starter.mjs"
  },
  "dependencies": {
    "csv-parse": "7.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@wp-playground/cli": "3.1.52",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
