{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#165D47"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#182B24"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#52665C"
        },
        {
          "slug": "base",
          "name": "Base",
          "color": "#FFFFFF"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#F2F5F0"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "System sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.0625rem"
        },
        {
          "slug": "large",
          "name": "Heading",
          "size": "2rem"
        },
        {
          "slug": "x-large",
          "name": "Display",
          "size": "3.25rem"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ],
      "spacingSizes": [
        {
          "slug": "20",
          "name": "20",
          "size": "1rem"
        },
        {
          "slug": "40",
          "name": "40",
          "size": "2rem"
        },
        {
          "slug": "60",
          "name": "60",
          "size": "4rem"
        },
        {
          "slug": "80",
          "name": "80",
          "size": "6rem"
        }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var:preset|color|base",
      "text": "var:preset|color|ink"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "24px",
        "right": "24px",
        "top": "0",
        "bottom": "0"
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "600",
          "lineHeight": "1.15",
          "letterSpacing": "-0.025em"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|accent"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|accent",
          "text": "var:preset|color|base"
        },
        "border": {
          "radius": "8px"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.4rem",
            "right": "1.4rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "landing",
      "title": "Landing page",
      "postTypes": [
        "page"
      ]
    }
  ]
}
