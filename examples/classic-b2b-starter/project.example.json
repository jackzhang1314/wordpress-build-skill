{
  "title": "Your Company",
  "description": "A neutral B2B starter description.",
  "slug": "your-company",
  "type": "wordpress-b2b",
  "domain": "example.hostingersite.com",
  "theme": "b2b-starter-theme",
  "plugin": "b2b-starter-model",
  "livePages": [
    "/",
    "/products/",
    "/industries/",
    "/guides/",
    "/about/",
    "/contact/"
  ],
  "contentMarkers": ["Your Company"],
  "contentCounts": [
    {"label": "Products", "postType": "starter_product", "expected": 6},
    {"label": "Product categories", "postType": "product_collection", "expected": 4, "kind": "term"},
    {"label": "Industries", "postType": "starter_industry", "expected": 3},
    {"label": "Guides", "postType": "starter_guide", "expected": 3},
    {"label": "News", "postType": "post", "expected": 1}
  ],
  "requiredPlugins": [
    "advanced-custom-fields",
    "seo-by-rank-math",
    "fluentform",
    "classic-editor"
  ],
  "disabledPlugins": [],
  "media": {"sources": []},
  "seed": {"enabled": true, "script": "scripts/seed.php", "data": "content/site-data.json"},
  "seo": {
    "organization": "Your Company",
    "postTypes": [
      {"name": "post", "sitemap": true, "metaBox": true, "richSnippet": "article"},
      {"name": "page", "sitemap": true, "metaBox": true},
      {"name": "starter_product", "sitemap": true, "metaBox": true, "richSnippet": "product"},
      {"name": "starter_industry", "sitemap": true, "metaBox": true},
      {"name": "starter_guide", "sitemap": true, "metaBox": true, "richSnippet": "article"}
    ],
    "taxonomies": [{"name": "product_collection", "sitemap": true, "metaBox": true}],
    "noindex": []
  },
  "paths": {"theme": "theme", "plugin": "plugin", "content": "content"},
  "hostinger": {"user": "REPLACE_HOSTINGER_USER", "order": "REPLACE_ORDER_ID"},
  "ssh": {
    "host": "REPLACE_SSH_HOST",
    "port": 65002,
    "user": "REPLACE_SSH_USER",
    "keyPath": "REPLACE_SSH_KEY_PATH",
    "wpPath": "REPLACE_REMOTE_WP_PATH"
  },
  "timezone": "Asia/Shanghai"
}
